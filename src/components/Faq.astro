---
import SecHead from './SecHead.astro';
import { faqs } from '../data/site';
---
<section class="sec" id="faq">
  <div class="wrap narrow">
    <SecHead badge="FAQ" icon="help">
      <Fragment slot="title">Questions founders ask</Fragment>
      Everything to know before you buy.
    </SecHead>
    <div class="faq rv">
      {faqs.map(([q, a]) => (
        <details><summary>{q}<span class="pm" aria-hidden="true"></span></summary><p set:html={a} /></details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })),
})} />
