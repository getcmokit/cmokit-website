---
import { CONFIG, roles } from '../data/site';
const { agents, skills, commands } = CONFIG.counts;
const items = [...roles, ...roles];
---
<header class="hero">
  <div class="ticker rise" aria-hidden="true">
    <div class="track">
      {items.map(([r, a]) => <span class="tk"><s>{r}</s>{a}</span>)}
    </div>
  </div>
  <div class="wrap">
    <h1 class="rise" style="animation-delay:.1s">The <em>CMO</em> your startup can <em>finally afford</em></h1>
    <p class="lede rise" style="animation-delay:.2s">{agents} specialist agents, {skills} skills and {commands} slash commands for Claude Code. SEO, AI search, content, ads and launches, run from your own repo.</p>
    <div class="hero-ctas rise" style="animation-delay:.3s">
      <a href="#pricing" class="btn btn-dark">Get CMOkit</a>
      <a href="#team" class="btn btn-ghost">Meet the team</a>
    </div>
    <p class="fine rise" style="animation-delay:.36s">Requires Claude Code<span>·</span>One-time payment<span>·</span>Lifetime updates</p>
    {CONFIG.launchNote && (
      <div class="rise" style="animation-delay:.44s">
        <div class="launch-hero"><span class="dot"></span><span><b>{CONFIG.price}</b>{CONFIG.comparePrice && <> <s>{CONFIG.comparePrice}</s></>} · {CONFIG.launchNote.toLowerCase()}</span></div>
      </div>
    )}
    <div class="stats rise" style="animation-delay:.52s">
      <div><b class="g">● {agents} agents</b> across marketing</div>
      <div><b>{skills}</b> skills</div>
      <div><b>{commands}</b> commands</div>
      <div><b>~2 min</b> to install</div>
      <div><b>No subscription</b> pay once</div>
    </div>
  </div>
</header>
