---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { CONFIG } from '../data/site';
---
{CONFIG.launchNote && (
  <a href="#pricing" class="announce">
    <Icon name="zap" size={13} />
    <span><b>Launch price</b> · <b class="o">{CONFIG.price}</b>{CONFIG.comparePrice && <> <s>{CONFIG.comparePrice}</s></>} for the first 20 customers</span>
    <Icon name="arrow" size={13} />
  </a>
)}
<nav id="nav">
  <div class="wrap nav-in">
    <Logo />
    <div class="nav-r">
      <div class="nav-links">
        <a href="#team">The team</a>
        <a href="#ai-search">AI search</a>
        <a href="#how">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </div>
      <a href="#pricing" class="btn btn-primary btn-sm nav-cta">Get CMOkit</a>
    </div>
  </div>
</nav>
