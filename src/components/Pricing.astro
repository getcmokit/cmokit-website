---
import SecHead from './SecHead.astro';
import Icon from './Icon.astro';
import { CONFIG } from '../data/site';
const { agents, skills, commands } = CONFIG.counts;
const feats = [
  `${agents} agents, ${skills} skills, ${commands} slash commands`,
  'SEO, GEO/AEO, local SEO, content, paid, email, CRO',
  'CLAUDE.md brand template',
  'The <code>cmokit</code> CLI installer',
  'Private GitHub repo access',
  'Lifetime updates',
  'Works with Pro, Max, Team or API',
  'Plain files: edit anything',
];
---
<section class="sec" id="pricing">
  <div class="wrap">
    <SecHead badge="Pricing" icon="dollar">
      <Fragment slot="title">No subscription. Pay once.</Fragment>
      Get private-repo access the moment you check out, and every future update after that.
    </SecHead>
    <div class="ticket rv">
      <div class="t-left">
        <h3>CMOkit</h3>
        <p>The complete kit, every department.</p>
        <div class="big"><b>{CONFIG.price}</b>{CONFIG.comparePrice && <s>{CONFIG.comparePrice}</s>}</div>
        <small>Lifetime license</small>
        <a href={CONFIG.checkoutUrl} class="btn btn-white btn-lg">Get lifetime access <Icon name="arrow" size={16} class="arr" /></a>
      </div>
      <div class="t-right">
        {CONFIG.launchNote && <div class="launch"><span class="pulse"></span>{CONFIG.launchNote}</div>}
        <ul>
          {feats.map((f) => <li><Icon name="check" size={16} /><span set:html={f} /></li>)}
        </ul>
        <p class="guar"><Icon name="shield" size={14} />Secure checkout via Polar · instant private-repo access · updates never touch your customizations</p>
      </div>
    </div>
  </div>
</section>
