---
import { CONFIG } from '../data/site';
const { agents, skills, commands } = CONFIG.counts;
---
<section class="sec" id="pricing">
  <div class="wrap">
    <div class="eyebrow rv"><span class="ico">$</span>Pricing</div>
    <div class="pricebox card rv">
      <div class="price-l">
        <h3>No subscription.</h3>
        <p>Pay once, get private-repo access the moment you check out, and every future update after that. Works with any Claude Code plan: Pro, Max, Team or API.</p>
        <ul>
          <li>{agents} agents, {skills} skills, {commands} slash commands</li>
          <li>SEO, GEO/AEO, local SEO, content, paid, email, CRO</li>
          <li>CLAUDE.md brand template + the <code>cmokit</code> CLI</li>
          <li>Private GitHub repo, lifetime updates</li>
        </ul>
        <p class="guar">Plain files in your repo. Edit anything; updates never touch your customizations.</p>
      </div>
      <div class="price-r">
        <small>CMOkit · complete</small>
        <div class="big"><b>{CONFIG.price}</b>{CONFIG.comparePrice && <s>{CONFIG.comparePrice}</s>}</div>
        {CONFIG.launchNote && <div class="launch">{CONFIG.launchNote}</div>}
        <div class="once">once, lifetime updates</div>
        <a href={CONFIG.checkoutUrl} class="btn btn-dark">Get CMOkit <span class="arr">→</span></a>
        <div class="secure">Secure checkout via Polar · instant private-repo access</div>
      </div>
    </div>
  </div>
</section>
