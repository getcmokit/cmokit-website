---
import { CONFIG } from '../data/site';
const { agents, skills, commands } = CONFIG.counts;
---
<section class="sec" id="pricing">
  <div class="wrap">
    <div class="eyebrow rv">Pricing</div>
    <h2 class="h2 rv">Hire once. <em>Never pay rent on it.</em></h2>
    <div class="price-grid">
      <div class="quote rv">
        <blockquote>“buying it last week was probably one of my best investments. genuinely love what he's building here 🔥”</blockquote>
        <div>
          <div class="by"><span class="av">A</span><div><b>abhi</b><small>Founder of craftpad · on AgentsKit, our first kit</small></div></div>
          <div class="guar">
            <div><b>Private repo</b>Access on checkout</div>
            <div><b>Lifetime updates</b>New skills, free</div>
            <div><b>Any Claude plan</b>Pro, Max, Team or API</div>
          </div>
        </div>
      </div>
      <div class="pricecard rv">
        <small>CMOkit · complete</small>
        <div class="big"><b>{CONFIG.price}</b>{CONFIG.comparePrice && <s>{CONFIG.comparePrice}</s>}</div>
        <div class="once">one-time payment · lifetime updates</div>
        <ul>
          <li>{agents} agents, {skills} skills, {commands} slash commands</li>
          <li>SEO, GEO/AEO, local SEO, content, paid, email, CRO</li>
          <li>CLAUDE.md brand template + the <span class="mono" style="font-size:13px">cmokit</span> CLI</li>
          <li>Private GitHub repo, every future update</li>
        </ul>
        <a href={CONFIG.checkoutUrl} class="btn btn-lime">Get CMOkit now <span class="arr">→</span></a>
        <div class="secure">Secure checkout · instant private-repo access</div>
      </div>
    </div>
  </div>
</section>
