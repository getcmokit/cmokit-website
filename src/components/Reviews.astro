---
import SecHead from './SecHead.astro';
import Icon from './Icon.astro';
import { reviews } from '../data/site';
const split = (q: string, h?: string) => {
  if (!h || !q.includes(h)) return [q, '', ''];
  const i = q.indexOf(h);
  return [q.slice(0, i), h, q.slice(i + h.length)];
};
---
<section class="sec">
  <div class="wrap">
    <SecHead badge="Reviews" icon="quote">
      <Fragment slot="title">From people who bought our kits</Fragment>
    </SecHead>
    <div class="reviews">
      {reviews.map((r) => {
        const [a, h, b] = split(r.quote, r.highlight);
        return (
          <figure class="review card rv">
            <div class="stars" aria-label="5 out of 5">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={16} />)}</div>
            <blockquote>{a}{h && <mark>{h}</mark>}{b}</blockquote>
            <figcaption class="by">
              {r.avatar ? <img class="av" src={r.avatar} alt={r.name} width="36" height="36" loading="lazy" /> : <span class="av">{r.name[0].toUpperCase()}</span>}
              <div><b>{r.name}</b><small>{r.meta}</small></div>
              {r.url && <a class="xlink" href={r.url} target="_blank" rel="noopener" aria-label={`${r.name} on X`}>𝕏</a>}
            </figcaption>
          </figure>
        );
      })}
      <div class="review maybe rv">
        <h3>Maybe you?</h3>
        <p>Ship your first campaign this week, then tell us how it went.</p>
        <a href="#pricing" class="btn btn-primary btn-sm">Get CMOkit</a>
      </div>
    </div>
  </div>
</section>
