---
import SecHead from './SecHead.astro';
import Icon from './Icon.astro';
import { departments } from '../data/site';
const icons = ['search', 'bot', 'pin', 'pen', 'megaphone', 'mail', 'trend', 'compass'];
const initials = (n: string) => n.split('-').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
<section class="sec" id="team">
  <div class="wrap">
    <SecHead badge="The team" icon="users">
      <Fragment slot="title">Every floor of a growth team.<br class="br" /> Already staffed.</Fragment>
      Ask in plain English. The <code>growth-strategist</code> finds the real bottleneck and hands each job to the specialist who should own it.
    </SecHead>
    <div class="tabs-wrap rv">
      <div class="tabs" role="tablist" aria-label="Departments">
        {departments.map((d, i) => (
          <button class="tab" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <Icon name={icons[i]} size={14} />{d.key}<span class="n">{d.skills.length + d.commands.length}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="rv">
      {departments.map((d, i) => (
        <div class="dept" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
          <div class="bento dept-grid">
            <div class="card dept-head">
              <div class="card-title"><Icon name={icons[i]} size={18} />{d.label}</div>
              <h3>{d.title}</h3>
              <p>{d.desc}</p>
              <div class="try"><span>Try saying</span><q>{d.tryThis}</q></div>
            </div>
            <div class="card agents-card">
              <div class="card-title"><Icon name="users" size={18} />Specialists on this floor</div>
              <div class="agents">
                {d.agents.map(([n, p]) => (
                  <div class="agent">
                    <span class="av">{initials(n)}</span>
                    <div><b>{n}</b><p>{p}</p></div>
                  </div>
                ))}
              </div>
            </div>
            <div class="card skills-card">
              <div class="card-title"><Icon name="sparkles" size={18} />Skills and commands</div>
              <div class="chips">
                {d.commands.map((c) => <span class="chip cmd">{c}</span>)}
                {d.skills.map((s) => <span class="chip">{s}</span>)}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
