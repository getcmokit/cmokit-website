---
// Post-checkout page. Polar redirects here with ?checkout_id={CHECKOUT_ID};
// the DataFast script in Base.astro reads that parameter and attributes the sale.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { CONFIG } from '../data/site';
---
<Base
  title="You're in — welcome to CMOkit"
  description="Thanks for buying CMOkit. Here's how to get repo access and install your AI marketing team."
  noindex
>
  <nav class="ty-nav">
    <div class="wrap nav-in">
      <Logo />
      <a href="/" class="btn btn-ghost ty-home">Back to site</a>
    </div>
  </nav>

  <main>
    <section class="ty-hero">
      <div class="wrap">
        <div class="ty-badge rise" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#d4f36b" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h1 class="rise" style="animation-delay:.08s">Your CMO <em>starts today.</em></h1>
        <p class="lede rise" style="animation-delay:.16s">
          Payment confirmed. Thanks for backing CMOkit. Your receipt and repo access link are on their way to your inbox.
        </p>
      </div>
    </section>

    <section class="ty-steps">
      <div class="wrap">
        <div class="eyebrow">Next steps</div>
        <div class="steps">
          <div class="step">
            <div class="num">01</div>
            <h4>Claim repo access</h4>
            <p>Open the email from Polar and connect your GitHub account. Then accept the invite to the private <code>getcmokit/cmokit</code> repo.</p>
          </div>
          <div class="step">
            <div class="num">02</div>
            <h4>Install</h4>
            <p>In your project folder, run the command below. It adds the team to <code>.claude/</code> and nothing global.</p>
          </div>
          <div class="step">
            <div class="num">03</div>
            <h4>Brief your CMO</h4>
            <p>Fill in <code>CLAUDE.md</code> once (product, audience, voice), then ask Claude for your first campaign.</p>
          </div>
        </div>

        <div class="term ty-term">
          <div class="term-bar"><i></i><i></i><i></i><span>your-startup — zsh</span></div>
          <div class="ty-cmd">
            <code><span class="p">$</span> {CONFIG.installCmd}</code>
            <button type="button" class="ty-copy" data-copy={CONFIG.installCmd}>Copy</button>
          </div>
        </div>

        <div class="ty-help">
          <p><b>Didn't get the email?</b> Check spam or promotions first. It comes from Polar and can take a few minutes. Still nothing? Reply to your receipt and we'll sort it out.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.querySelectorAll<HTMLButtonElement>('.ty-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Select & copy';
        }
        setTimeout(() => (btn.textContent = 'Copy'), 1800);
      });
    });
  </script>
</Base>

<style>
  .ty-nav { position: static; }
  .ty-home { padding: 10px 18px; font-size: 14px; }
  .ty-hero { padding: 72px 0 24px; text-align: center; }
  .ty-badge {
    width: 64px; height: 64px; margin: 0 auto; border-radius: 20px;
    background: var(--forest); display: grid; place-items: center;
    box-shadow: 0 16px 40px -16px rgba(18,58,44,.7);
  }
  .ty-hero h1 {
    font-family: var(--serif); font-weight: 400; letter-spacing: -.025em;
    font-size: clamp(48px, 8vw, 104px); line-height: .95; margin: 28px auto 0; max-width: 860px;
  }
  .ty-hero h1 em { color: var(--forest-3); }
  .ty-hero .lede { max-width: 560px; margin: 24px auto 0; font-size: 18px; color: var(--muted); }
  .ty-steps { padding: 56px 0 110px; }
  .ty-steps .steps { margin-top: 24px; }
  .ty-term { margin-top: 16px; }
  .ty-cmd {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 22px 24px; font-family: var(--mono); font-size: 14px; color: rgba(255,255,255,.85);
  }
  .ty-cmd code { overflow-x: auto; white-space: nowrap; }
  .ty-copy {
    flex-shrink: 0; border: 0; cursor: pointer; border-radius: 999px; padding: 8px 16px;
    background: var(--lime); color: var(--forest); font: 600 13px var(--sans);
    transition: background .2s ease;
  }
  .ty-copy:hover { background: var(--lime-2); }
  .ty-help {
    margin-top: 24px; background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--r); padding: 20px 24px; font-size: 15px; color: var(--muted);
  }
  .ty-help b { color: var(--ink); }
  @media (max-width: 960px) {
    .ty-steps .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .ty-hero { padding: 48px 0 16px; }
    .ty-cmd { flex-direction: column; align-items: stretch; padding: 18px; font-size: 13px; }
    .ty-copy { align-self: flex-start; }
  }
</style>
